# Main_V0.2 runs a single-core application image on the nRF54L15 application MCU
# (Cortex-M33). The FLPR RISC-V coprocessor is not used by this board revision.
config BOARD_LIFEGPS
	select SOC_NRF54L15_CPUAPP if BOARD_LIFEGPS_NRF54L15_CPUAPP

# Bring-up only: the one-shot sensor-hub diagnostic in src/imu/lsm6dsr.c. It
# proves the auxiliary I2C read/write paths and decodes the per-slave NACK bits
# before the streaming configuration is written, which is what localised the dead
# BMP388 on the 2026-11-19 bench unit. It costs about 4 s of boot time and a few
# hundred bytes of log strings, so it stays off in normal builds.
config LGPS_IMU_HUB_DIAG
	bool "Run the sensor hub bring-up diagnostic once at boot"
	default n

# Bench debugging escape hatch for the GNSS power policy: a receiver that runs
# continuously cannot be watched on a scope or in u-center, because README section
# 11 cuts the rail after the 60 s cold-start window (no fix) or 35 s after the
# first fix (ephemeris collected). With this set, src/gnss/gnss.c never calls
# gnss_power_down() on its own, so the receiver stays in full multi-GNSS tracking
# until the board is powered off.
#
# Off by default: a continuously powered MAX-M10S draws about 8 mA at the 1.8 V
# rail on top of the rest of the system, which is the whole point of the policy.
# The build-time flag is deliberate - nothing on the BLE command path can put the
# rail in a state where a lost link leaves it on forever.
config LGPS_GNSS_ALWAYS_ON
	bool "Keep the GNSS rail powered (disable the timeout power policy)"
	default n

# 10 Hz needs more line rate than 38400 can carry once anything else is on the
# wire: NAV-PVT is 100 bytes per epoch (1 kB/s at 10 Hz, fine), but the factory
# NMEA set is ~1.25 kB per epoch and NAV-SAT is 16 + 12*n bytes. The profile in
# src/gnss/gnss.c therefore writes three keys once the first NAV-PVT readback
# proves the receiver answers at the boot rate - NMEA output off,
# CFG-RATE-MEAS, then CFG-UART1-BAUDRATE = 460800 (RAM layer, so the next power
# cycle starts at 38400 again) - and waits for each ACK.
#
# 460800 is legal on both sides: MAX-M10S integration manual table 16 lists it and
# the nRF54L15 UARTE limit is 1 Mbit/s on the UARTE20-22/30 instances (datasheet
# section 11.24). The BAUDRATE table value gives 457143 bit/s from a 16 MHz PCLK,
# i.e. -0.8 %, inside the UART tolerance, but it does depend on HFCLK coming from
# the 32 MHz crystal.
#
# If the receiver never answers at the new rate, the firmware drops the link back
# to 38400 by itself after 10 s (gnss.c, cold-start state).
config LGPS_GNSS_FAST_LINK
	bool "Raise the GNSS link to 460800 and sample at the configured rate"
	default n

config LGPS_GNSS_RATE_MS
	int "GNSS measurement period written at power-up (ms)"
	depends on LGPS_GNSS_FAST_LINK
	default 100
	range 25 1000

# Sensor calibration: MAG_CAL (0x41) and ACCEL_CAL (0x43). The capture state
# machines, the coefficient maths and the 80-byte record in the external NOR.
# Coefficients are applied in software - lifegps/calib.h records why the sensor
# offset registers (X/Y/Z_OFS_USR, LIS2MDL OFFSET_*) are not used.
config LGPS_CALIB
	bool "Sensor calibration (accelerometer / gyroscope / magnetometer)"
	default y

# Sector 16 is the first sector after the 16-sector trajectory ring. The record
# is append-only inside this 4 KB sector; see Firmware/docs/PARTITIONS.md.
config LGPS_CALIB_SECTOR_INDEX
	int "External NOR sector holding the calibration record"
	depends on LGPS_CALIB
	default 16
	range 16 4095

# Barometric baseline: one 20-byte record, append-only in its own 4 KB sector.
# Sector 17 sits right after the calibration sector so "clear calibration" (which
# erases sector 16 as a whole) cannot drop the height reference, and a full
# calibration log cannot erase the baseline. See Firmware/docs/PARTITIONS.md.
config LGPS_BARO_SECTOR_INDEX
	int "External NOR sector holding the barometric baseline record"
	default 17
	range 16 4095
