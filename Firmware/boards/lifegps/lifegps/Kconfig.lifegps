# Main_V0.2 runs a single-core application image on the nRF54L15 application MCU
# (Cortex-M33). The FLPR RISC-V coprocessor is not used by this board revision.
config BOARD_LIFEGPS
	select SOC_NRF54L15_CPUAPP if BOARD_LIFEGPS_NRF54L15_CPUAPP
